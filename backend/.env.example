# Local development. For Railway, use the dashboard variables documented in README.md.
NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rfid_attendance
DB_POOL_SIZE=5
DB_AUTO_INIT=true
# Use DB_SSL=true for a provider requiring TLS; optionally set DB_SSL_CA.
DB_SSL=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
DEVICE_API_KEY=CHANGE_THIS_TO_A_RANDOM_DEVICE_KEY
SESSION_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SCAN_COOLDOWN_MS=5000
# Railway terminates HTTPS at its reverse proxy. Use 1 in Railway, 0 locally.
TRUST_PROXY_HOPS=0
